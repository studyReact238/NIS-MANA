
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the LinkFlow application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        }
      },
      "required": [
        "id"
      ]
    },
    "Tag": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tag",
      "type": "object",
      "description": "Represents a reusable tag used for categorizing learning links.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Tag entity."
        },
        "name": {
          "type": "string",
          "description": "The textual name of the tag."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "LearningLink": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LearningLink",
      "type": "object",
      "description": "A shared learning resource managed by admins.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the LearningLink entity."
        },
        "title": {
          "type": "string",
          "description": "The title of the learning link."
        },
        "url": {
          "type": "string",
          "description": "The URL of the learning resource.",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "description": "Summary or description."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "color": {
          "type": "string",
          "description": "Theme color name."
        },
        "icon": {
          "type": "string",
          "description": "Icon name."
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the admin who created this link."
        },
        "completedCount": {
          "type": "number",
          "description": "Total number of users who completed this link."
        },
        "upvoteCount": {
          "type": "number",
          "description": "Total number of upvotes."
        },
        "downvoteCount": {
          "type": "number",
          "description": "Total number of downvotes."
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "color",
        "icon",
        "createdAt",
        "updatedAt",
        "createdBy",
        "completedCount",
        "upvoteCount",
        "downvoteCount"
      ]
    },
    "UserProgress": {
      "title": "UserProgress",
      "type": "object",
      "description": "Individual user's progress on a link.",
      "properties": {
        "isCompleted": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      }
    },
    "Vote": {
      "title": "Vote",
      "type": "object",
      "description": "A user's vote on a link.",
      "properties": {
        "type": { "type": "string", "enum": ["up", "down"] },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/learningLinks/{linkId}",
        "definition": {
          "entityName": "LearningLink",
          "schema": { "$ref": "#/backend/entities/LearningLink" },
          "description": "Global shared learning links managed by admins."
        }
      },
      {
        "path": "/learningLinks/{linkId}/votes/{userId}",
        "definition": {
          "entityName": "Vote",
          "schema": { "$ref": "#/backend/entities/Vote" },
          "description": "User votes on a link."
        }
      },
      {
        "path": "/users/{userId}/progress/{linkId}",
        "definition": {
          "entityName": "UserProgress",
          "schema": { "$ref": "#/backend/entities/UserProgress" },
          "description": "User-specific completion status."
        }
      },
      {
        "path": "/admins/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Admin identification."
        }
      }
    ]
  }
}
