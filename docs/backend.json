
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "LinkFlowアプリケーション内の登録ユーザーを表します。基本的なユーザー情報を保存します。",
      "properties": {
        "id": {
          "type": "string",
          "description": "ユーザーのユニークID。"
        },
        "email": {
          "type": "string",
          "description": "ユーザーのメールアドレス。",
          "format": "email"
        },
        "name": {
          "type": "string",
          "description": "ユーザーの表示名。"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "管理権限フラグ（UI制御用）。"
        },
        "createdAt": {
          "type": "number",
          "description": "作成日時のタイムスタンプ。"
        },
        "updatedAt": {
          "type": "number",
          "description": "更新日時のタイムスタンプ。"
        }
      },
      "required": [
        "id",
        "email",
        "isAdmin",
        "createdAt",
        "updatedAt"
      ]
    },
    "Tag": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tag",
      "type": "object",
      "description": "リンクを整理するためのタグ。",
      "properties": {
        "id": {
          "type": "string",
          "description": "タグのID。"
        },
        "name": {
          "type": "string",
          "description": "タグ名。"
        },
        "createdAt": {
          "type": "number",
          "description": "作成日時。"
        },
        "updatedAt": {
          "type": "number",
          "description": "更新日時。"
        }
      },
      "required": [
        "id",
        "name",
        "createdAt",
        "updatedAt"
      ]
    },
    "LearningLink": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LearningLink",
      "type": "object",
      "description": "ユーザーが管理する学習リソースのリンク。",
      "properties": {
        "id": {
          "type": "string",
          "description": "リンクのID。"
        },
        "userId": {
          "type": "string",
          "description": "所有者のUID。"
        },
        "title": {
          "type": "string",
          "description": "リンクのタイトル。"
        },
        "url": {
          "type": "string",
          "description": "リソースのURL。",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "description": "AIによる要約または説明。"
        },
        "tagIds": {
          "type": "array",
          "description": "関連タグのID配列。",
          "items": {
            "type": "string"
          }
        },
        "isCompleted": {
          "type": "boolean",
          "description": "受講済みフラグ。"
        },
        "color": {
          "type": "string",
          "description": "カードのカラーテーマ。"
        },
        "icon": {
          "type": "string",
          "description": "カードのアイコン名。"
        },
        "createdAt": {
          "type": "number",
          "description": "作成日時。"
        },
        "updatedAt": {
          "type": "number",
          "description": "更新日時。"
        }
      },
      "required": [
        "id",
        "userId",
        "title",
        "url",
        "tagIds",
        "isCompleted",
        "color",
        "icon",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "ユーザープロフィール情報。",
          "params": [
            {
              "name": "userId",
              "description": "ユーザーのUID。"
            }
          ]
        }
      },
      {
        "path": "/admins/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "管理者権限を付与されたユーザーのUIDを保持するコレクション。ここにドキュメントが存在するユーザーは管理者として振る舞います。",
          "params": [
            {
              "name": "userId",
              "description": "管理権限を持つユーザーのUID。"
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/learningLinks/{learningLinkId}",
        "definition": {
          "entityName": "LearningLink",
          "schema": {
            "$ref": "#/backend/entities/LearningLink"
          },
          "description": "ユーザーごとの学習リンク。所有者または管理者のみがアクセス可能です。",
          "params": [
            {
              "name": "userId",
              "description": "所有者のUID。"
            },
            {
              "name": "learningLinkId",
              "description": "リンクのID。"
            }
          ]
        }
      }
    ]
  }
}
