
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // admins コレクションにログインユーザーのUIDが存在するかをチェック
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // グローバル共有リンク
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    // リンクへの投票
    match /learningLinks/{linkId}/votes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // 受講者名簿：管理者は全件閲覧可能、ユーザーは自分のデータのみ
    match /learningLinks/{linkId}/completions/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ユーザー個別の進捗管理
    match /users/{userId}/progress/{linkId} {
      allow read, write: if isOwner(userId);
    }

    // ユーザープロファイル
    match /users/{userId} {
      allow get, list, create, update: if isOwner(userId);
    }

    // 管理者名簿（デバッグパネルや管理判定で使用）
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
