
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // activities (タイムライン) - 最優先で許可
    match /activities/{activityId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // admins (管理者名簿)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // learningLinks (グローバル共有リンク)
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      
      allow update: if isAdmin() 
                    || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid)
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'downvoteCount', 'learningCount', 'completedCount', 'updatedAt', 'isRecommended']));
      
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid);

      match /votes/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /completions/{userId} {
        allow read: if isSignedIn();
        allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }

      match /learners/{userId} {
        allow read: if isSignedIn();
        allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }
    }

    // users (ユーザープロファイル)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();

      match /progress/{linkId} {
        allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
