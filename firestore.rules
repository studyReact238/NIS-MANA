
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // グローバル共有リンク
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.createdBy);
    }

    // リンクへの投票
    match /learningLinks/{linkId}/votes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // 受講完了者名簿・学習中ユーザー名簿
    // 管理者による一括メンテナンス（再集計）を許可
    match /learningLinks/{linkId}/completions/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /learningLinks/{linkId}/learners/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ユーザー個別の進捗管理
    // 管理者が統計のために読み取ることを許可
    match /users/{userId}/progress/{linkId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // ユーザープロファイル
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 管理者名簿
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // タイムライン
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete, update: if isAdmin();
    }
  }
}
