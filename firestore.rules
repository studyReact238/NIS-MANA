
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // グローバル共有リンク
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // 管理者、または作成者本人のみ更新・削除が可能
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.createdBy);
    }

    // リンクへの投票
    match /learningLinks/{linkId}/votes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // 受講完了者名簿
    match /learningLinks/{linkId}/completions/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || isOwner(userId);
      // 再集計(メンテナンス)のため、管理者も書き込み可能にする
      allow write: if isOwner(userId) || isAdmin();
    }

    // 学習中ユーザー名簿
    match /learningLinks/{linkId}/learners/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || isOwner(userId);
      // 再集計(メンテナンス)のため、管理者も書き込み可能にする
      allow write: if isOwner(userId) || isAdmin();
    }

    // ユーザー個別の進捗管理
    match /users/{userId}/progress/{linkId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // ユーザープロファイル
    match /users/{userId} {
      // 投稿者情報を表示するため、サインインしていれば誰でも取得(get)・リスト表示(list)を可能にする
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 管理者名簿
    match /admins/{userId} {
      // 管理者マークを表示するため、サインインしていれば誰でも取得(get)可能にする
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // タイムライン
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete, update: if isAdmin();
    }
  }
}
