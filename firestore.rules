
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Core Philosophy: 
     * This ruleset enforces a strict user-ownership model where private data is nested under 
     * user-specific paths. It prioritizes Authorization Independence by using denormalized 
     * ownership fields and a dedicated administration collection to avoid costly cross-document lookups.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isAdmin();
    }

    match /users/{userId}/learningLinks/{learningLinkId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    match /tags/{tagId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /admins/{userId} {
      // ユーザーが自分が管理者かどうかを確認できるように get を許可
      // ルールの再適用を確実にするためのコメント追加
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
