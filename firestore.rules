rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. activities (タイムライン) - 認証済みユーザーに全権限を付与
    match /activities/{activityId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 共通関数
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 2. admins (管理者名簿)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. learningLinks (グローバル共有リンク)
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      
      allow update: if isAdmin() 
                    || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid)
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'downvoteCount', 'learningCount', 'completedCount', 'updatedAt', 'isRecommended']));
      
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid);

      match /votes/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /completions/{userId} {
        allow read: if isSignedIn();
        allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }

      match /learners/{userId} {
        allow read: if isSignedIn();
        allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }
    }

    // 4. users (ユーザープロファイル)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();

      match /progress/{linkId} {
        allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}