
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // グローバル共有リンク
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    // リンクへの投票
    match /learningLinks/{linkId}/votes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // 受講者名簿
    match /learningLinks/{linkId}/completions/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ユーザー個別の進捗管理
    match /users/{userId}/progress/{linkId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // ユーザープロファイル
    match /users/{userId} {
      allow get, create, update: if isOwner(userId) || isAdmin();
      allow list, delete: if isAdmin();
    }

    // 管理者名簿
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // タイムライン
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete, update: if isAdmin();
    }
  }
}
