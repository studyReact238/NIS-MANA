
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 基本的な認証・認可チェック関数
    function isSignedIn() {
      // authオブジェクトとuidが確実に存在することを確認
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 1. activities (タイムライン) - 最優先で評価
    // 認証済みユーザーに読み取り（一覧・単体）と作成を許可
    match /activities/{activityId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 2. admins (管理者名簿)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. learningLinks (グローバル共有リンク)
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      
      // 一般ユーザーは統計カウントと更新日時のみ更新可能
      allow update: if isAdmin() 
                    || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid)
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'downvoteCount', 'learningCount', 'completedCount', 'updatedAt', 'isRecommended']));
      
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid);

      // サブコレクション（投票、完了者、学習者）
      match /votes/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      match /completions/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /learners/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // 4. users (ユーザープロファイル)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // ユーザー個別の進捗管理
      match /progress/{linkId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }
  }
}
