
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // グローバル共有リンク：全員閲覧可、追加・編集は管理者のみ
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // カウントの更新は一般ユーザーも行う可能性があるため、updateを許可
      allow update: if isSignedIn();
    }

    // リンクへの投票
    match /learningLinks/{linkId}/votes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ユーザー個別の進捗管理：本人だけが読み書き可能
    match /users/{userId}/progress/{linkId} {
      allow read, write: if isOwner(userId);
    }

    // ユーザープロファイル
    match /users/{userId} {
      allow get, list, create, update: if isOwner(userId);
    }

    // 管理者名簿
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
