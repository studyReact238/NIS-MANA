
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 作成者かどうかのチェック
    function isCreator() {
      return isSignedIn() && resource.data != null && resource.data.get('createdBy', '') == request.auth.uid;
    }

    // 統計カウントと更新日時のみの更新を許可
    function onlyStatsChanging() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['upvoteCount', 'downvoteCount', 'learningCount', 'completedCount', 'updatedAt', 'isRecommended']);
    }

    // タイムライン（不具合修正のため上位に移動し、権限を明示化）
    match /activities/{activityId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow delete, update: if isAdmin();
    }

    // グローバル共有リンク
    match /learningLinks/{linkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      
      // 管理者または作成者は全フィールド更新可能。
      // 一般ユーザーは統計カウントのみ更新可能。
      allow update: if isAdmin() 
                    || isCreator()
                    || (isSignedIn() && onlyStatsChanging());
      
      allow delete: if isAdmin() || isCreator();
    }

    // リンクへの投票
    match /learningLinks/{linkId}/votes/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // 受講完了者名簿・学習中ユーザー名簿
    match /learningLinks/{linkId}/completions/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /learningLinks/{linkId}/learners/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ユーザー個別の進捗管理
    match /users/{userId}/progress/{linkId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // ユーザープロファイル
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 管理者名簿
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
